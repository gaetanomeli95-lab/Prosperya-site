# Resend API key per l’invio dei messaggi di contatto
RESEND_API_KEY=re_xxxxxxxx

# Indirizzo email destinatario dei contatti
CONTACT_EMAIL=direzione@prosperya.it

# Link di pagamento online per la consulenza Start Up
# Inserire qui il Payment Link reale del provider scelto (es. Stripe/PayPal)
NEXT_PUBLIC_STARTUP_PAYMENT_URL=

# Imposta a true per disabilitare l’indicizzazione durante sviluppo/preview
NEXT_PUBLIC_NOINDEX=true
