# Resend API key per l’invio dei messaggi di contatto
RESEND_API_KEY=re_xxxxxxxx

# Indirizzo email destinatario dei contatti
CONTACT_EMAIL=direzione@prosperya.it

# Mittente verificato in Resend (es. Prosperya <contatti@prosperya.it>)
RESEND_FROM_EMAIL=Prosperya <onboarding@resend.dev>

# Link Stripe Checkout per la consulenza Start Up (€50 IVA inclusa)
NEXT_PUBLIC_STARTUP_PAYMENT_URL=

# Link Stripe Checkout per la consulenza Finanza agevolata (€50 IVA inclusa)
NEXT_PUBLIC_FINANZA_PAYMENT_URL=

# Durata minima confermata della consulenza
CONSULTATION_DURATION_MINUTES=60

# ID del calendario Google dedicato alle consulenze, da configurare in fase di integrazione
GOOGLE_CALENDAR_ID=

# Imposta a true per disabilitare l’indicizzazione durante sviluppo/preview
NEXT_PUBLIC_NOINDEX=true
